{
  "name": "refract-protocol-backend",
  "version": "0.1.0",
  "description": "Refract Protocol backend — oracle monitoring, claim processing, premium quoting",
  "main": "dist/main.js",
  "private": true,
  "workspaces": [
    "refract-backend",
    "refract-frontend",
    "refract-contracts"
  ],
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nodemon --exec ts-node src/main.ts",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "start:worker": "nest start --entryFile worker",
    "start:worker:dev": "nest start --watch --entryFile worker",
    "start:worker:prod": "node dist/worker",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "npm run test:unit && npm run test:contracts",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:property": "jest --testRegex '.*\\.property\\.spec\\.ts$'",
    "test:integration": "jest --config test/integration/jest.integration.config.ts --runInBand",
    "test:unit": "npm run test --workspaces --if-present",
    "test:contracts": "node test/contracts/verify.js",
    "test:contracts:update": "node test/contracts/verify.js --update",
    "attack-cost": "node scripts/attack-cost.js",
    "attack-cost:reference": "node scripts/attack-cost.js --fixture test/fixtures/attack-cost/reference.json",
    "ci": "npm run lint && npm run test",
    "migrate:up": "node-pg-migrate up --migrations-dir migrations --config-file database.json",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --config-file database.json",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --config-file database.json",
    "migrate:status": "node-pg-migrate status --migrations-dir migrations --config-file database.json",
    "soroban:up": "docker compose -f test/soroban/docker-compose.yml up -d --wait",
    "soroban:down": "docker compose -f test/soroban/docker-compose.yml down -v",
    "soroban:bootstrap": "ts-node scripts/soroban-bootstrap.ts",
    "test:soroban": "jest --config test/soroban/jest.soroban.config.js",
    "regenerate:xdr-fixtures": "ts-node scripts/regenerate-xdr-fixtures.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1142.0",
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-ws": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^11.1.28",
    "@prometheus-io/client": "^0.16.1",
    "@stellar/stellar-sdk": "^16.3.0",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "nest-winston": "^1.10.2",
    "node-pg-migrate": "7.9.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^14.0.3",
    "winston": "^3.11.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@babel/plugin-transform-modules-commonjs": "^7.29.7",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^11.1.28",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.10.0",
    "@types/pg": "^8.10.9",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^9.0.7",
    "@types/ws": "^8.5.10",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "babel-jest": "^30.5.2",
    "eslint": "^8.57.0",
    "fast-check": "^4.10.2",
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.1.0",
    "typescript": "^5.3.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "testMatch": [
      "**/src/**/*.spec.ts"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest",
      "^.+\\.js$": [
        "babel-jest",
        {
          "plugins": [
            "@babel/plugin-transform-modules-commonjs"
          ]
        }
      ]
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(?:@stellar/stellar-sdk|@noble/.*|@scure/.*|uint8array-extras|hexoid|bignumber.js|@stellar|@noble|@scure|stellar-base|crc|tweetnacl|base32.js|@adraffy|@noble/curves))"
    ],
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage"
  }
}
