{
  "name": "stellar-claim-backend",
  "version": "0.1.0",
  "description": "Refract Protocol backend \u2014 oracle monitoring, claim processing, premium quoting",
  "main": "dist/main.js",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "jest",
    "migrate:up": "node-pg-migrate up --migrations-dir migrations --config-file database.json",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --config-file database.json",
    "migrate:create": "node-pg-migrate create --migrations-dir migrations --config-file database.json",
    "migrate:status": "node-pg-migrate status --migrations-dir migrations --config-file database.json",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "soroban:up": "docker compose -f test/soroban/docker-compose.yml up -d --wait",
    "soroban:down": "docker compose -f test/soroban/docker-compose.yml down -v",
    "soroban:bootstrap": "ts-node scripts/soroban-bootstrap.ts",
    "test:soroban": "jest --config test/soroban/jest.soroban.config.js",
    "regenerate:xdr-fixtures": "ts-node scripts/regenerate-xdr-fixtures.ts",
    "test:integration": "jest --config test/integration/jest.integration.config.ts --runInBand"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@nestjs/platform-ws": "^11.1.28",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.0.0",
    "@nestjs/websockets": "^11.1.28",
    "@stellar/stellar-sdk": "^12.3.0",
    "axios": "^1.6.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "nest-winston": "^1.10.2",
    "node-pg-migrate": "7.9.1",
    "pg": "^8.11.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^9.0.0",
    "winston": "^3.11.0",
    "ws": "^8.16.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/node": "^20.3.1",
    "@types/supertest": "^2.0.12",
    "jest": "^29.5.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.1.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
