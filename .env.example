# ─── Refract Backend configuration ─────────────────────────────────────────────
# Copy to `.env` and fill in. Never commit `.env` (it is gitignored).

# ── HTTP server ──────────────────────────────────────────────────────────────
# Port the API/WebSocket server listens on.
PORT=4001
# Comma-separated exact browser origins; no paths or wildcards. FRONTEND_URL
# remains supported as a single-origin fallback for existing deployments.
FRONTEND_URLS=http://localhost:3000
FRONTEND_URL=http://localhost:3000
# Required by endpoints marked with @AdminOnly. Send as X-API-Key.
ADMIN_API_KEY=

# ── Database (PostgreSQL 15+) ────────────────────────────────────────────────
# Apply src/db/schema.sql before first run:  psql "$DATABASE_URL" -f src/db/schema.sql
DATABASE_URL=postgres://refract:refract@localhost:5432/refract

# Connection pool tuning (all optional — defaults shown).
# DB_POOL_MAX=10                  # max simultaneous connections
# DB_POOL_MIN=2                   # min idle connections kept alive
# DB_POOL_IDLE_TIMEOUT_MS=30000   # close idle connections after this
# DB_POOL_ACQUIRE_TIMEOUT_MS=5000 # throw if no free connection within this
# DB_STATEMENT_TIMEOUT_MS=30000   # hard cap per query (statement_timeout GUC)
# DB_CONNECT_RETRIES=5            # startup probe retry limit
# DB_CONNECT_RETRY_DELAY_MS=1000  # base delay between retries (doubles each attempt)

# ── Cache / pub-sub (Redis) ──────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Stellar / Soroban ────────────────────────────────────────────────────────
STELLAR_NETWORK=testnet
# RPC URL, Horizon URL, and passphrase are selected together by STELLAR_NETWORK.
# Set contract IDs for the selected network only; keep values from that
# network's refract-contracts deployment output.
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
# Optional comma-separated fallback Soroban RPC endpoints. Calls retry with
# exponential backoff and fail over across these endpoints on transport errors.
# SOROBAN_RPC_URLS=https://rpc-one.example,https://rpc-two.example
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
# Ledger at which event ingestion should begin when no checkpoint exists.
# Choose a ledger available from the configured RPC endpoint.
SOROBAN_EVENT_START_LEDGER=1

# Deployed contract IDs (see refract-contracts deploy output).
REFRACT_POOL_CONTRACT_ID_TESTNET=
REFRACT_POLICY_CONTRACT_ID_TESTNET=
REFRACT_ORACLE_CONTRACT_ID_TESTNET=
# REFRACT_POOL_CONTRACT_ID_FUTURENET=
# REFRACT_POLICY_CONTRACT_ID_FUTURENET=
# REFRACT_ORACLE_CONTRACT_ID_FUTURENET=
# REFRACT_POOL_CONTRACT_ID_MAINNET=
# REFRACT_POLICY_CONTRACT_ID_MAINNET=
# REFRACT_ORACLE_CONTRACT_ID_MAINNET=

# Relayer/admin secret used to push oracle readings on-chain and settle claims.
# Rotate via a rolling deployment: new replicas use this key while old replicas
# drain in-flight settlements. Keep the old account funded until its submitted
# work drains; PostgreSQL advisory locks serialize sequence use across replicas.
# Use a dedicated, low-value testnet key. NEVER use a mainnet key here.
#
# Prefer sourcing this from AWS Secrets Manager rather than an environment
# variable: grant the runtime IAM role access to the secret and set
# ORACLE_RELAYER_SECRET_ID instead of ORACLE_RELAYER_SECRET.
ORACLE_RELAYER_SECRET=
# AWS Secrets Manager secret containing the relayer's Stellar secret key.
# Grant the runtime IAM role access to this secret; never put the signing key
# in an environment variable. Use a dedicated, low-value testnet key.
ORACLE_RELAYER_SECRET_ID=
# Multi-key relayer keystore: a JSON file (mode 0600, mounted from a secret
# manager) with a "keys" array of { id, secret, network, active } entries.
# Re-read when it changes, so rotation/revocation needs no restart. Takes
# precedence over ORACLE_RELAYER_SECRET (dev default only). Never logged.
# See docs/relayer-key-compromise-runbook.md.
# ORACLE_RELAYER_KEYSTORE_PATH=/run/secrets/relayer-keystore.json
# Oracle publish quorum (N-of-M independent submitter signatures).
# ORACLE_QUORUM_PAYOUT_THRESHOLD=2      # payout-triggering feeds (default 2)
# ORACLE_QUORUM_DEFAULT_THRESHOLD=1     # feeds listed in NON_PAYOUT_FEEDS
# ORACLE_QUORUM_NON_PAYOUT_FEEDS=
# ORACLE_QUORUM_THRESHOLDS=FlightDelay=3   # per-feed override
# Startup fails if a threshold exceeds active keys or the on-chain required_signers().
# Defaults to AWS_REGION/AWS_DEFAULT_REGION from the AWS runtime environment.
# AWS_REGION=

# Bootstrap validation (fail-fast vs degraded). Defaults are safe for local/test.
# STELLAR_VALIDATE_ONCHAIN=true
# STELLAR_REQUIRE_NETWORK=false
# STELLAR_VALIDATE_TIMEOUT_MS=5000

# Relayer sequence / fee controls (shared by claim settlement + oracle publish).
# RELAYER_FEE_MULTIPLIER=1.2
# RELAYER_FEE_CEILING=1000000
# RELAYER_IDLE_RESYNC_MS=30000
# RELAYER_MIN_BALANCE=50000000
# RELAYER_MAX_ATTEMPTS=3

# ── Soroban event indexer ────────────────────────────────────────────────────
# Polls getEvents for pool/policy/oracle contracts and projects into Postgres.
# Apply migrations/001_event_indexer.sql (or the indexer tables in schema.sql).
#
# IMPORTANT: Only ONE replica should run the indexer (leader election). Set
# EVENT_INDEXER_ENABLED=false on followers to avoid competing cursor writers.
# EVENT_INDEXER_ENABLED=true
# EVENT_INDEXER_POLL_INTERVAL_MS=5000
# EVENT_INDEXER_LAG_ALERT_LEDGERS=100
# EVENT_INDEXER_PAGE_LIMIT=100

# ── Confirmation polling (exponential backoff) ──────────────────────────────
# CONFIRMATION_INITIAL_INTERVAL_MS=400
# CONFIRMATION_BACKOFF_MULTIPLIER=1.8
# CONFIRMATION_MAX_INTERVAL_MS=8000
# CONFIRMATION_DEADLINE_MS=30000
# CONFIRMATION_JITTER_RATIO=0.2
# CONFIRMATION_SETTLEMENT_DEADLINE_MS=90000
# CONFIRMATION_HTTP_DEADLINE_MS=20000

# ── Oracle on-chain publish policy ───────────────────────────────────────────
# ORACLE_PUBLISH_MODE=on_change   # or every_poll
# ORACLE_PUBLISH_MIN_INTERVAL_MS=300000

# ── Oracle trust modes (staged rollout) ──────────────────────────────────────
# Per-coverage trust mode: single_source (default) | corroborated | decentralized.
# Coverage suffixes: STABLECOIN_DEPEG, MARKET_CRASH, LIQUIDATION_SHIELD,
# SMART_CONTRACT_RISK, FLIGHT_DELAY. Unknown suffixes or modes fail at startup.
# ORACLE_TRUST_MODE_STABLECOIN_DEPEG=single_source
# ORACLE_TRUST_MODE_MARKET_CRASH=corroborated
# Distinct sources (corroborated) or registered provider identities
# (decentralized), comma-separated. Required for non-default modes.
# ORACLE_SOURCES_MARKET_CRASH=coingecko,defillama,horizon
# Minimum distinct agreeing sources for a non-default mode (integer >= 2).
# ORACLE_QUORUM_MIN=2

# ── Oracle leader election (Redis lease) ─────────────────────────────────────
# Only the replica holding the lease polls providers, publishes to RefractOracle,
# and settles claims. Followers stay up for API/reads. Uses REDIS_URL.
# Set false only for a single replica; disabled mode always reports leader.
# ORACLE_LEADER_ELECTION=true
# Lease TTL: how long a crashed leader blocks failover (ms).
# ORACLE_LEASE_TTL_MS=15000
# Renew/acquire cadence; must be less than ORACLE_LEASE_TTL_MS (ms).
# ORACLE_LEASE_RENEW_MS=5000
# Failure semantics: if Redis is unreachable or renewal fails, the leader steps
# down and publishing/settlement stop. The instance keeps serving reads and API
# traffic, logs a critical alert, and `refract_oracle_leader` drops to 0.

# Pending buy_policy records expire if the user never submits (ms).
# POLICY_PENDING_TTL_MS=3600000

# ── External oracle data sources ─────────────────────────────────────────────
# CoinGecko, Stellar Horizon, and DeFiLlama are all used for real and need
# no API key for this project's request volume. Horizon is selected with
# STELLAR_NETWORK. The other overrides below are optional.
# COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# DEFILLAMA_BASE_URL=https://api.llama.fi
# Protocol slug DeFiLlama's /protocol/:slug endpoint is polled for the
# SmartContractRisk TVL-drop check — a placeholder "covered protocol"
# until Refract defines a real list.
# DEFILLAMA_PROTOCOL_SLUG=aave
# Independent secondary providers used for corroboration (see
# docs/oracle-sources.md). Kraken (price) is keyless and on by default; Token
# Terminal (TVL) is only registered when a key is set. Supply the key through
# your secret manager / environment, never commit it.
# KRAKEN_ENABLED=true
# KRAKEN_BASE_URL=https://api.kraken.com
# TOKENTERMINAL_BASE_URL=https://api.tokenterminal.com
# TOKENTERMINAL_API_KEY=
# Timeout (ms) for each oracle HTTP call before it degrades to a safe,
# non-triggering reading (see OracleService.degraded()).
# ORACLE_HTTP_TIMEOUT_MS=5000

# Registered third-party data providers allowed to submit signed readings to
# POST /api/v1/oracle/submissions (see docs/oracle-submissions.md). JSON array.
# ORACLE_SUBMISSION_PROVIDERS=[{"id":"acme-feeds","publicKey":"<base64 raw Ed25519 key>","coverageTypes":["StablecoinDepeg"]}]

# ── Provider canary probes (src/services/providerProbe.ts) ───────────────────
# Out-of-band probes of each data provider. Results never reach on-chain
# publishing or corroboration. Keep the interval long enough that canary
# traffic stays small next to real polling (shared provider rate limits).
# PROVIDER_PROBE_INTERVAL_SECONDS=300
# PROVIDER_PROBE_JITTER_SECONDS=30
# PROVIDER_PROBE_TIMEOUT_MS=5000
# Identical payloads in this many consecutive probes count as a frozen feed.
# PROVIDER_PROBE_FROZEN_WINDOW=3
# Consecutive provider failures before the source is quarantined and alerted.
# PROVIDER_PROBE_QUARANTINE_AFTER=3

# Oracle confidence → quote availability and premium (src/quote/oracle-confidence.ts).
# Score is the product of source-count, independence, freshness, and divergence
# factors. Below UNAVAILABLE_BELOW the quote is refused; below DEGRADED_BELOW it
# is priced with a warning. The premium multiplier scales with (1 - score) and is
# capped at MAX_PREMIUM_MULTIPLIER, so pricing stays within regulator-defensible bounds.
# ORACLE_CONFIDENCE_MIN_SOURCES=2
# ORACLE_CONFIDENCE_MIN_INDEPENDENT_CLUSTERS=2
# ORACLE_CONFIDENCE_MAX_FRESHNESS_SECONDS=300
# ORACLE_CONFIDENCE_DIVERGENCE_PENALTY=0.5
# ORACLE_CONFIDENCE_DEGRADED_BELOW=0.8
# ORACLE_CONFIDENCE_UNAVAILABLE_BELOW=0.5
# ORACLE_CONFIDENCE_MAX_PREMIUM_MULTIPLIER=1.5

# ── Soroban RPC client (shared SorobanRpcService) ────────────────────────────
# SOROBAN_RPC_TIMEOUT_MS=10000
# SOROBAN_RPC_MAX_RETRIES=3
# Max stroops the relayer will pay for a RestoreFootprint (griefing guard).
# SOROBAN_RESTORE_FEE_CEILING=5000000
# SOROBAN_RESTORE_MAX_ATTEMPTS=3
# Proactive TTL extension (testnet/mainnet thresholds differ — keep config-driven).
# SOROBAN_TTL_EXTENSION_LEDGERS=17280
# SOROBAN_PROACTIVE_TTL_EXTEND_DAYS=30

# ── Claim scanner ────────────────────────────────────────────────────────────
# Max parallel oracle/evaluate workers per scan (settlement stays serial).
# CLAIM_SCAN_CONCURRENCY=8
# Allowed |actual-expected| payout delta before discrepancy alert (default exact).
# CLAIM_PAYOUT_MISMATCH_TOLERANCE=0

# ── FlightDelay data source (issue #181) ────────────────────────────────────
# Unset FLIGHT_DELAY_PROVIDER to disable FlightDelay readings entirely.
# FLIGHT_DELAY_PROVIDER=aviationstack
# Required when FLIGHT_DELAY_PROVIDER=aviationstack (free-tier key). Startup fails
# fast if it is missing. Never logged.
# AVIATIONSTACK_API_KEY=
# "paid-stub" selects a placeholder for a future paid provider and always errors.

# ── Fee strategy (issue #46) ─────────────────────────────────────────────────
# Hard ceiling on inclusion+resource fee in stroops (safety control).
# FEE_CEILING_STROOPS=10000000
# FEE_STATS_TTL_MS=15000
# FEE_MODERATE_PERCENTILE=90
# FEE_MODERATE_MULTIPLIER=1.2
# FEE_AGGRESSIVE_PERCENTILE=99
# FEE_AGGRESSIVE_MULTIPLIER=1.5

# ── Settlement retry / dead-letter (issue #48) ───────────────────────────────
# SETTLEMENT_MAX_ATTEMPTS=10
# SETTLEMENT_MAX_AGE_MS=86400000
# SETTLEMENT_BACKOFF_BASE_MS=300000
# SETTLEMENT_FAILURE_RATE_ALERT=0.5

# ── Ops API ──────────────────────────────────────────────────────────────────
# Bearer token for GET/POST /api/v1/claims/ops/* endpoints.
# OPS_API_TOKEN=

# Horizon ledger finality: confirmations before a Horizon-derived reading counts toward quorum
# HORIZON_FINALITY_DEPTH=5
# final_only (default) | allow_provisional
# HORIZON_FINALITY_POLICY=final_only
